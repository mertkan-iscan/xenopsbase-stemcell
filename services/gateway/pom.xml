        <!--
            3.x now that this service is on Boot 4 / Framework 7, matching core. springdoc 3.x
            needs org.springframework.web.reactive.accept.ApiVersionStrategy, which only exists on
            Framework 7; on the old Boot 3.5 line it failed at runtime with a NoClassDefFoundError
            buried under a @ConditionalOnMissingBean deduction failure. OpenApiSpecIT is what
            catches that, in either direction.
        -->
        <springdoc-openapi-starter-webflux-api.version>3.0.3</springdoc-openapi-starter-webflux-api.version>
