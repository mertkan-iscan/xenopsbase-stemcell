# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Access key IDs are identifiers, not secrets, but they are still not committed
# to a public repository. The matching SECRET keys never appear here at all --
# they live in AWS_SECRET_ACCESS_KEY in the environment.

region     = "fsn1"
prefix     = "xenopsbase"
project_id = "1234567" # numeric part of the Hetzner Cloud console URL

# One key pair per consumer, generated in
# Hetzner Cloud Console -> Object Storage -> Credentials.
# Hetzner has no API for this, so it is a manual bootstrap step in the same
# category as the age key in ADR-0003.
access_keys = {
  infra         = "" # Terraform and CI. Keeps access to every bucket.
  app           = "" # Core service. Documents only.
  db            = "" # CloudNativePG. Database backups only.
  observability = "" # Loki. Log chunks only.
}

# Leave false for the first apply. Verify the key IDs above are correct, then
# set true and apply again.
#
# A policy built from a wrong key ID locks everyone out of the bucket, including
# Terraform, and cannot be removed without a Hetzner support ticket.
enable_bucket_policies = false

# Backstops only. Each owning component enforces its own, SHORTER retention.
# These must stay longer, or objects vanish underneath a component that still
# believes it owns them.
retention_days = {
  documents_noncurrent = 90
  pg_backups           = 35 # must exceed CloudNativePG's retention policy
  loki_chunks          = 30 # must exceed Loki's retention_period
  tfstate_noncurrent   = 365
  abort_multipart      = 7
}
