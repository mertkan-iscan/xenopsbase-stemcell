# Copy to <environment>.secrets.tfvars and fill in. Those files are gitignored.
#
#   cp env/secrets.tfvars.example env/dev.secrets.tfvars
#
# Access key IDs are identifiers, not secrets — but they are half of a
# credential pair and this repository is public, so they stay out of it.
# The 40-character SECRET keys never appear here at all; they live in
# TF_VAR_hetzner_s3_access_key / _secret_key in the environment.

project_id = "" # numeric part of the Hetzner console URL

# One key pair per consumer, per environment. A dev key must never be
# allowlisted on a prod bucket — that is the whole reason buckets are named per
# environment.
access_keys = {
  infra         = ""
  app           = ""
  db            = ""
  observability = ""

  # xenopsbase-learn's packaging service: course archives and unpacked course
  # files. Its own pair rather than `app`'s, because sharing one would let a
  # leaked learn credential read core's documents and the reverse -- which is
  # the whole reason these policies exist.
  #
  # ONLY THE ID GOES HERE. The 40-character secret half goes into the
  # `learn-packaging-storage` SOPS secret, which is what the pod reads.
  # Terraform never needs it: all it does with this key is name it in the
  # bucket policy's NotPrincipal list.
  packaging = ""
}
