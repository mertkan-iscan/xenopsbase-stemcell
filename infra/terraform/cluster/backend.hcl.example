# Copy to backend.hcl and fill in. backend.hcl is gitignored.
#
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
#
# ⚠️ This points at CLOUDFLARE R2, not Hetzner. See ADR-0005.
#
# Credentials for this backend are the R2 ones:
#   export AWS_ACCESS_KEY_ID=<r2 access key id>
#   export AWS_SECRET_ACCESS_KEY=<r2 secret access key>

bucket = "xenopsbase-tfstate"

# One key per environment. Never share a key between environments: the lock is
# per state object, so a shared key means dev applies block prod applies.
#
# Note this is the CLUSTER state. The durable buckets live in a separate root
# module under storage/terraform.tfstate, deliberately out of reach of the
# destroy that `make down` runs against this one.
key = "dev/cluster.tfstate"

# R2 has no regions. "auto" is the required literal.
region = "auto"

endpoints = {
  s3 = "https://<account_id>.r2.cloudflarestorage.com"
}
