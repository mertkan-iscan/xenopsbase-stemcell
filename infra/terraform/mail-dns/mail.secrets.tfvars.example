# Copy to mail.secrets.tfvars and fill in. mail.secrets.tfvars is gitignored
# by the *.secrets.tfvars rule.
#
# The API token is NOT here. Supply it via the environment:
#   export TF_VAR_cloudflare_api_token=...
# scoped to Zone / DNS / Edit on this zone and nothing else.

zone_id = "<zone id from the Cloudflare overview page>"

brevo_verification_code  = "<the value inside brevo-code:... on the apex TXT>"
site_target              = "<project>.pages.dev"
google_site_verification = "<the value after google-site-verification=>"

# One-time, for adopting records that already exist. Delete along with
# imports.tf once `terraform plan` is clean. Fetch with:
#   curl -s -H "Authorization: Bearer $TF_VAR_cloudflare_api_token" \
#     "https://api.cloudflare.com/client/v4/zones/$ZONE/dns_records?per_page=100" \
#     | jq -r '.result[] | "\(.name)\t\(.type)\t\(.id)"'
import_record_ids = {
  brevo_verification      = ""
  brevo_sending           = ""
  brevo_tracking_redirect = ""
  brevo_tracking_image    = ""
  brevo_dkim_1            = ""
  brevo_dkim_2            = ""
  dmarc                   = ""
  site                    = ""
  google_verification     = ""
}
