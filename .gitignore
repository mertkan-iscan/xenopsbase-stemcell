# This repository is public. Everything below either contains credentials or is
# machine-local state that must never be committed.

# --- secrets -----------------------------------------------------------------
# age private keys. The one bootstrap secret from ADR-0003. Never in git.
*.agekey
key.txt
keys.txt
.env
.env.*
!.env.example

# --- terraform ---------------------------------------------------------------
.terraform/
.terraform.tfstate.lock.info

# State never lives in git; it lives in the versioned bucket (ADR-0002).
*.tfstate
*.tfstate.*
*.tfstate.backup

# Real backend files. Only the .example versions are tracked.
backend.hcl

# Per-environment tfvars ARE tracked (infra/terraform/*/env/*.tfvars) so that
# adding an environment is a reviewable change rather than an untracked local
# edit. Only the secrets half stays out.
*.secrets.tfvars
!*.secrets.tfvars.example

# Legacy single-environment files, superseded by env/ per T-1.4.
/infra/terraform/*/terraform.tfvars

crash.log
crash.*.log

# .terraform.lock.hcl IS committed on purpose: provider versions must be
# reproducible across a rebuild.

# kube-hetzner writes this next to the Terraform code as a local_sensitive_file.
# It is cluster configuration and is not safe to publish.
*_kustomization_backup.yaml

# --- kubernetes --------------------------------------------------------------
kubeconfig
kubeconfig.yaml
*.kubeconfig

# --- build and tooling -------------------------------------------------------
target/
build/
node_modules/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- java services ---------------------------------------------------------
# Build output. Regenerated by Maven; never reviewed, and large.
services/*/target/
services/*/build.log
services/*/b.log
services/gen.log

# The Maven wrapper jar IS committed on purpose (62KB). mvnw ships with it, and
# T-4.1 wants a clone to build without Maven pre-installed. A fork that has to
# install a build tool first is a fork that starts with a yak.

# Generator state. DELETED in T-3.4, not merely ignored -- re-running the
# generator over this tree would restore the user mirroring, the docker files
# and Liquibase as though they were an update. These entries exist so a stray
# regeneration attempt cannot be committed by accident.
services/.yo-rc.json
services/*/.yo-rc.json
services/*/.jhipster/

# Generated client sources. The SPEC is committed (docs/api), the generated code is not:
# it is reproducible from the spec by `make api-client`, and committing it would mean
# reviewing thousands of generated lines on every API change.
/clients/java/target/

# Generated from the deployed realm by `make dev-realm` (T-4.1).
infra/dev/.generated/
infra/dev/.logs/

# k6 run output. load-test.sh writes the full summary next to the invocation so
# a failure can be read after the fact; it is a per-run artefact, not a record.
# The numbers worth keeping go in docs/slos.md.
k6-baseline-*.log
k6-write-*.log

# Scalability run artifacts: k6 log, cluster timeline, events, report (T-5.10).
# The report is the thing worth keeping, and it belongs in docs/slos.md when a
# run says something new -- not as a directory of every run anyone ever did.
.scale-runs/

# scalability-charts.py imports scalability-report.py by path, which makes
# CPython write bytecode next to the scripts.
infra/scripts/__pycache__/

# Packer writes the candidate snapshot id here so validate-golden-image.sh knows
# exactly which image the build just made, rather than guessing at "the newest
# candidate" and promoting the wrong one when two builds overlap (T-1.20). It is a
# per-run artefact; the id that matters ends up as a label on the snapshot.
infra/packer/manifest.json
infra/packer/manifest.json.lock
