# This repository is public. Everything below either contains credentials or is
# machine-local state that must never be committed.

# --- secrets -----------------------------------------------------------------
# age private keys. The one bootstrap secret from ADR-0003. Never in git.
*.agekey
key.txt
keys.txt
.env
.env.*
!.env.example

# --- terraform ---------------------------------------------------------------
.terraform/
.terraform.tfstate.lock.info

# State never lives in git; it lives in the versioned bucket (ADR-0002).
*.tfstate
*.tfstate.*
*.tfstate.backup

# Real backend files. Only the .example versions are tracked.
backend.hcl

# Per-environment tfvars ARE tracked (infra/terraform/*/env/*.tfvars) so that
# adding an environment is a reviewable change rather than an untracked local
# edit. Only the secrets half stays out.
*.secrets.tfvars
!*.secrets.tfvars.example

# Legacy single-environment files, superseded by env/ per T-1.4.
/infra/terraform/*/terraform.tfvars

crash.log
crash.*.log

# .terraform.lock.hcl IS committed on purpose: provider versions must be
# reproducible across a rebuild.

# kube-hetzner writes this next to the Terraform code as a local_sensitive_file.
# It is cluster configuration and is not safe to publish.
*_kustomization_backup.yaml

# --- kubernetes --------------------------------------------------------------
kubeconfig
kubeconfig.yaml
*.kubeconfig

# --- build and tooling -------------------------------------------------------
target/
build/
node_modules/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
